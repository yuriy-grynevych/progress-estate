generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

// ──────────────────────────────────────────────
// ADMIN USERS
// ──────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String?
  phone          String?
  photoUrl       String?
  agentToken     String   @unique @default(cuid())
  telegramChatId String?
  instagram      String?
  accentColor    String?  @default("#C9A84C")
  role           UserRole @default(EMPLOYEE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedProperties Property[]
  referredInquiries  Inquiry[]  @relation("ReferredBy")
  assignedInquiries  Inquiry[]  @relation("InquiryAssigned")
  contacts           Contact[]
  sentMessages       ChatMessage[]
  sales              Sale[]
  tasks              Task[]
  contactNotes       ContactNote[]
  collections        Collection[]

  @@map("users")
}

enum ContactType {
  CLIENT
  OWNER
}

model Contact {
  id             String      @id @default(cuid())
  type           ContactType
  name           String
  phone          String?
  email          String?
  notes          String?
  source         String?
  assignedUserId String?
  assignedUser   User?       @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  properties     Property[]
  purchases      Sale[]
  followUpAt     DateTime?
  followUpSent   Boolean     @default(false)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tasks          Task[]
  history        ContactNote[]

  @@index([type])
  @@index([assignedUserId])
  @@map("contacts")
}

// ──────────────────────────────────────────────
// PROPERTIES
// ──────────────────────────────────────────────
model Property {
  id            String        @id @default(cuid())
  slug          String        @unique
  titleUk       String
  titleEn       String
  descriptionUk String        @default("")
  descriptionEn String        @default("")
  type          PropertyType
  listingType   ListingType
  status        ListingStatus @default(ACTIVE)
  price         Decimal       @db.Decimal(12, 2)
  currency      String        @default("UAH")
  areaSqm       Float
  landAreaSqm   Float?
  rooms         Int?
  bedrooms      Int?
  bathrooms     Int?
  floor         Int?
  totalFloors   Int?
  yearBuilt     Int?
  kitchenSqm    Float?
  gasType       String?
  renovationType String?
  buildingStage String?
  wallType      String?
  houseNumber        String?
  apartmentNumber    String?
  apartmentLetter    String?
  residentialComplex String?
  landmark           String?
  pricePer           String?       @default("OBJECT")
  source             String?
  commissionAmount   Float?
  commissionType     String?
  commissionCurrency String?
  internalNote       String?
  city               String        @default("Івано-Франківськ")
  district      String?
  address       String?
  latitude      Float?
  longitude     Float?
  features      String[]
  isFeatured    Boolean       @default(false)
  viewCount     Int           @default(0)
  olxAdId       String?
  olxPublishedAt DateTime?
  metaTitleUk   String?
  metaTitleEn   String?
  metaDescUk    String?
  metaDescEn    String?
  agentComments Json          @default("[]")
  previousPrice Decimal?      @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignedUserId  String?
  assignedUser    User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  ownerContactId  String?
  ownerContact    Contact? @relation(fields: [ownerContactId], references: [id], onDelete: SetNull)

  images          PropertyImage[]
  inquiries       Inquiry[]
  auditLogs       PropertyAuditLog[]
  sales           Sale[]
  collectionItems CollectionItem[]

  @@index([listingType, status])
  @@index([type, status])
  @@index([city])
  @@map("properties")
}

enum PropertyType {
  APARTMENT
  ROOM
  HOUSE
  APARTMENT_PREMIUM
  VILLA
  PENTHOUSE
  TOWNHOUSE
  DUPLEX
  COMMERCIAL
  OFFICE
  RETAIL
  WAREHOUSE
  INDUSTRIAL
  FOOD_SERVICE
  SERVICE_OBJECT
  OTHER_OBJECT
  SHOP
  HOTEL_ROOM
  WHOLE_BUILDING
  LAND
  LAND_INDIVIDUAL
  LAND_GARDEN
  LAND_FARM
  LAND_COMMERCIAL
  GARAGE
  PARKING
}

enum ListingType {
  SALE
  RENT
  DAILY_RENT
}

enum ListingStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
  DEPOSIT
}

// ──────────────────────────────────────────────
// PROPERTY IMAGES
// ──────────────────────────────────────────────
model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  altText    String?
  order      Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

// ──────────────────────────────────────────────
// CONTACT INQUIRIES
// ──────────────────────────────────────────────
model Inquiry {
  id         String        @id @default(cuid())
  propertyId String?
  name       String
  email      String
  phone      String?
  message    String
  status     InquiryStatus @default(NEW)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  source           String?
  chatHistory      Json?

  funnelStage      String    @default("NEW")
  deadline         DateTime?

  referredByUserId String?
  referredBy       User?   @relation("ReferredBy", fields: [referredByUserId], references: [id], onDelete: SetNull)

  assignedUserId   String?
  assignedUser     User?     @relation("InquiryAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)

  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([funnelStage])
  @@map("inquiries")
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ──────────────────────────────────────────────
// PROPERTY FEATURES (managed by admin)
// ──────────────────────────────────────────────
model Feature {
  id       String @id @default(cuid())
  value    String @unique
  labelUk  String
  labelEn  String
  order    Int    @default(0)

  @@map("features")
}

// ──────────────────────────────────────────────
// PROPERTY AUDIT LOG
// ──────────────────────────────────────────────
model PropertyAuditLog {
  id         String   @id @default(cuid())
  propertyId String
  userId     String
  userName   String
  changes    Json
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_audit_logs")
}

// ──────────────────────────────────────────────
// DISTRICTS (managed by admin)
// ──────────────────────────────────────────────
model District {
  id      String @id @default(cuid())
  value   String @unique
  labelUk String
  labelEn String
  order   Int    @default(0)

  @@map("districts")
}

// ──────────────────────────────────────────────
// INTERNAL CHAT
// ──────────────────────────────────────────────
model ChatMessage {
  id            String   @id @default(cuid())
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receiverId    String?  // null = general channel, userId = DM
  content       String
  type          String   @default("text") // "text" | "file" | "property"
  fileUrl       String?
  fileName      String?
  propertySlug  String?
  propertyTitle String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([senderId, receiverId])
  @@map("chat_messages")
}

// ──────────────────────────────────────────────
// SALES
// ──────────────────────────────────────────────
model Sale {
  id              String    @id @default(cuid())
  saleType        String    @default("OWN") // OWN | EXTERNAL

  // OWN type — link to our property
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // EXTERNAL type — manually entered
  externalName    String?
  externalAddress String?

  // Buyer (from contacts or manual)
  clientContactId String?
  clientContact   Contact?  @relation(fields: [clientContactId], references: [id], onDelete: SetNull)
  clientName      String?
  clientPhone     String?

  commission      Float?
  commissionType  String?   @default("FIXED") // FIXED | PERCENT
  currency        String    @default("USD")
  saleDate        DateTime  @default(now())
  note            String?

  agentId         String?
  agent           User?     @relation(fields: [agentId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("sales")
}

// ──────────────────────────────────────────────
// CONTACT HISTORY NOTES
// ──────────────────────────────────────────────
model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contact_notes")
}

// ──────────────────────────────────────────────
// TASKS
// ──────────────────────────────────────────────
model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  dueAt        DateTime?
  isDone       Boolean   @default(false)
  reminderSent Boolean   @default(false)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([dueAt])
  @@map("tasks")
}

// ──────────────────────────────────────────────
// COLLECTIONS
// ──────────────────────────────────────────────
model Collection {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  propertyId   String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  property     Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, propertyId])
  @@index([collectionId])
  @@map("collection_items")
}

// ──────────────────────────────────────────────
// TESTIMONIALS
// ──────────────────────────────────────────────
model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?
  contentUk   String
  contentEn   String
  rating      Int      @default(5)
  isPublished Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}
